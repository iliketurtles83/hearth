ANTHROPIC_API_KEY=your_key_here

# Base URL of the OpenAI-compatible inference server (llama.cpp, vLLM, etc.).
# - Docker (docker compose up): set to the service hostname, e.g.
#   OPENAI_BASE_URL=http://llama-server:8080/v1
# - Bare-host dev: set to
#   OPENAI_BASE_URL=http://localhost:10000/v1
#OPENAI_BASE_URL=http://localhost:10000/v1

# Model name as registered in the inference server (the alias used at startup).
OPENAI_CHAT_MODEL=gemma-4
ROUTER_EMBED_MODEL=nomic-embed-text
ROUTER_EMBED_TIMEOUT_MS=10000
ROUTER_EMBEDDING_ENABLED=true
# Optional: override the embedding model used by the embedding router.
# ROUTER_EMBED_MODEL=nomic-embed-text
MODEL_CLOUD=claude-sonnet-4-20250514

# Optional: vision model (defaults to chat model if not set)
# OPENAI_VISION_MODEL=gemma-4

# Optional: enable thinking/reasoning mode (llama.cpp --thinking support)
# OPENAI_THINK=true

# OpenAI model residency / startup warmup
# Keep loaded models resident in VRAM this long after their last use.
# "0" = never unload (llama.cpp doesn't auto-unload like Ollama).
OPENAI_KEEP_ALIVE=30m
# Pre-load the chat model into VRAM at backend startup so the first /chat is
# fast instead of paying the one-time model-load. Set false to skip.
CHAT_MODEL_WARMUP=true
# Timeout (seconds) for the startup warmup call — must exceed the cold
# model-load time (~80s for gemma4:e4b).
CHAT_MODEL_WARMUP_TIMEOUT_S=180

# Memory: interval "sleep" consolidation.
# A background job wakes on an interval and distills pending episodic summaries
# into semantic memory (facts, preferences, and knowledge-graph triples), then
# prunes expired facts. It only acts for users who have been idle, so the heavy
# LLM pass never runs mid-conversation.
MEMORY_SLEEP_ENABLED=true
# Seconds between scheduler heartbeats.
MEMORY_SLEEP_INTERVAL_SECONDS=900
# A user must be inactive this long (seconds) before their memory is consolidated.
MEMORY_SLEEP_IDLE_SECONDS=1800
# Max summaries to process per user per pass.
MEMORY_CONSOLIDATION_BATCH_SIZE=50
# Optional mid-conversation consolidation trigger. 0 (default) = disabled, the
# sleep job above handles consolidation. Set >0 (e.g. 3) to also consolidate
# inline once that many unconsolidated summaries accumulate.
MEMORY_CONSOLIDATION_THRESHOLD=0

# User/audio
PUID=1000
PGID=1000
XDG_RUNTIME_DIR=/run/user/1000
PULSE_SOCKET=/run/user/1000/pulse/native
# MPD server (music playback). The defaults match the Docker service name/port;
# set these for bare-host dev where MPD runs elsewhere.
MPD_HOST=mpd
MPD_PORT=6600
# Text-to-speech engine: piper | kokoro
TTS_ENGINE=piper

# Web / security
# CORS: keep the permissive "*" for plain-HTTP local dev. Once Caddy/HTTPS is the
# browser-facing edge, set this to the exact origin(s), e.g. https://hearth.lan.
CORS_ORIGINS=*
# Set true when Caddy terminates TLS so session cookies are sent only over HTTPS.
SESSION_COOKIE_SECURE=false

# Paths
MUSIC_PATH=/path/to/music
BEETS_DB_DIR=/path/to/beets/db
BEETS_DB_PATH=/beets/library.db
MUSIC_ROOT=/music

# Bare-host dev paths (Docker overrides these via the /tmp/hearth volume)
# Only needed when running uvicorn directly on the host instead of in Docker;
# in the container these point under /tmp/hearth/ automatically.
# MEMORY_DB_PATH=/tmp/hearth-local/memory.db
# CHROMA_PATH=/tmp/hearth-local/chroma
# AUTH_DB_PATH=/tmp/hearth-local/auth.db
# GRAPH_CHECKPOINT_DB_PATH=/tmp/hearth-local/graph-checkpoints.sqlite
